{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "NokeAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "NokeAgent"
  },
  "runtimes": [
    {
      "name": "NokeAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/NokeAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "BEDROCK_REGION",      "value": "us-east-2" },
        { "name": "BEDROCK_MODEL_ID",    "value": "us.amazon.nova-micro-v1:0" },
        { "name": "AGENT_AUTH_ENABLED",   "value": "false" },
        { "name": "AGENT_GATEWAY_URL",    "value": "https://nokeagent-nokemcpgateway-f1kx7iz7lg.gateway.bedrock-agentcore.us-east-2.amazonaws.com/mcp" },
        { "name": "AGENT_GATEWAY_REGION", "value": "us-east-2" },
        { "name": "AWS_REGION",           "value": "us-east-2" }
      ]
    },
    {
      "name": "NokeMCP",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/NokeMCP/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "VPC",
      "networkConfig": {
        "subnets": [
          "subnet-0cf7e5bfbe5cbdd5d",
          "subnet-011751ae28b96183d",
          "subnet-0ea9e1408cb9486d5"
        ],
        "securityGroups": ["sg-0bbed7d400a9db657"]
      },
      "protocol": "HTTP",
      "envVars": [
        { "name": "DB_HOST",     "value": "noke-mysql-cluster.cluster-cmftlirsxmms.us-east-2.rds.amazonaws.com" },
        { "name": "DB_PORT",     "value": "3306" },
        { "name": "DB_USER",     "value": "pradesh_kumar" },
        { "name": "DB_PASSWORD", "value": "Alpha45Df0#@#$" },
        { "name": "DB_SCHEMA",   "value": "smartentry-main" },
        { "name": "AGENT_AUTH_ENABLED", "value": "false" }
      ]
    }
  ],
  "memories": [
    {
      "name": "NokeAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "NokeMCPGateway",
      "description": "Gateway for EKS-hosted Noke MCP server",
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "targets": [
        {
          "name": "NokeMCPEksTarget",
          "targetType": "mcpServer",
          "endpoint": "https://mcp.smartentry.noke.dev/mcp-http/",
          "outboundAuth": {
            "type": "NONE"
          }
        }
      ]
    }
  ],
  "mcpRuntimeTools": [],
  "unassignedTargets": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": [],
  "harnesses": [],
  "datasets": []
}
