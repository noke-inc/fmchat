{
  "_meta": {
    "version": "1.1.0",
    "scope": "Enterprise Storage Engine Integration - Strict Datatypes Iteration",
    "tables_allowed": ["v2_units", "users", "users_roles", "sites", "v2_locks", "v2_locks_to_units"]
  },
  "entities": {
    "unit": {
      "physical_table": "v2_units",
      "aliases": ["unit", "units", "storage unit", "space", "spaces", "locker", "lockers"],
      "allowed_columns": {
        "id": { "type": "int" },
        "name": { "type": "varchar" },
        "rental_state": { "type": "varchar" },
        "access_type": { "type": "varchar" },
        "details_width": { "type": "float" },
        "details_depth": { "type": "float" },
        "details_price": { "type": "float" },
        "company_id": { "type": "int" },
        "site_id": { "type": "int" }
      },
      "allowed_aggregations": {
        "count": { "sql_function": "COUNT(*)", "output_column": "count" },
        "sum": { "sql_function": "SUM({column})", "requires_column": true, "output_column": "total", "allowed_columns": ["details_price", "details_width", "details_depth"] },
        "avg": { "sql_function": "AVG({column})", "requires_column": true, "output_column": "average", "allowed_columns": ["details_price", "details_width", "details_depth"] }
      },
      "column_metadata": {
        "rental_state": {
          "aliases": ["status", "state", "rental status", "availability", "occupancy"],
          "allowed_values": ["available", "in use", "repo"],
          "enum_map": {
            "available": ["available", "free", "open", "empty", "vacant"],
            "in use": ["inuse", "overlock", "testing", "gatelock", "auction-smartentry", "occupied", "rented", "taken", "active"],
            "repo": ["repo", "auction"]
          }
        }
      },
      "relationships": {
        "site": "v2_units.site_id = sites.id",
        "lock": "v2_locks_to_units.unit_id = v2_units.id",
        "user": "users_units_parameters.unit_id = v2_units.id"
      }
    },
    "user": {
      "physical_table": "users",
      "aliases": ["user", "users", "customer", "customers", "tenant", "tenants"],
      "allowed_columns": {
        "id": { "type": "int" },
        "first_name": { "type": "varchar" },
        "last_name": { "type": "varchar" },       
        "type": { "type": "varchar" },
        "state": { "type": "varchar" },
        "created_date": { "type": "timestamp" }        
      },
      "allowed_aggregations": {
        "count": { "sql_function": "COUNT(*)", "output_column": "count" }
      },
      "column_metadata": {
        "state": {
          "aliases": ["user status", "account state", "account status", "active"],
          "allowed_values": ["active", "inactive"],
          "enum_map": {
            "active": ["active", "verified", "logged_in"],
            "inactive": ["inactive", "suspended", "frozen", "banned"]
          }
        }
      },
      "relationships": {
        "site": "users_roles.user_id = users.id",
        "unit": "users_units_parameters.user_id = users.id"
      }
    },
    "site": {
      "physical_table": "sites",
      "aliases": ["site", "sites", "facility", "facilities", "location", "property"],
      "allowed_columns": {
        "id": { "type": "int" },
        "name": { "type": "varchar" },
        "city": { "type": "varchar" },
        "state": { "type": "varchar" }
      },
      "relationships": {
        "unit": "v2_units.site_id = sites.id",
        "user": "users_roles.site_id = sites.id"
      }
    },
    "lock": {
      "physical_table": "v2_locks",
       "aliases": ["lock", "locks", "hardware", "smart lock", "padlock", "padlocks"],
      "allowed_columns": {
        "id": { "type": "int" },
        "name": { "type": "varchar" },
        "ble_hw_version": { "type": "varchar" },
        "company_id": { "type": "int" }
      },
      "relationships": {
        "unit": "v2_locks_to_units.lock_id = v2_locks.id"
      }, 
      "column_metadata": {
        "ble_hw_version": {
          "aliases": ["version", "hardware type", "lock model", "hardware version", "model"],
          "allowed_values": ["noke volt", "noke one", "noke contact", "noke screen", "noke ion", "noke pad"],
          "enum_map": {
            "noke volt": ["3e", "2e", "1w", "noke volt", "volt"],
            "noke one": ["1a", "noke one", "one"],
            "noke contact": ["2a", "noke contact", "contact"],
            "noke screen": ["4k", "noke screen", "screen"],
            "noke ion": ["4e", "noke ion", "ion"],
            "noke pad": ["3k", "noke pad", "padlock", "pad"]
          }
        }
      }
    },
    "role": {
      "physical_table": "roles",
      "aliases": ["role", "roles", "permission", "permissions", "job title", "access level"],
      "allowed_columns": {
        "id": { "type": "int" },
        "name": { "type": "varchar" }
      },
      "relationships": {
        "user": "users_roles.role_id = roles.id"
      }
    }
  },
  "junction_bridges": {
    "unit.user": { "via_table": "users_units_parameters", "step_1": "users_units_parameters.unit_id = v2_units.id", "step_2": "users_units_parameters.user_id = users.id" },
    "user.unit": { "via_table": "users_units_parameters", "step_1": "users_units_parameters.user_id = users.id", "step_2": "users_units_parameters.unit_id = v2_units.id" },
    "user.site": { "via_table": "users_roles", "step_1": "users_roles.user_id = users.id", "step_2": "users_roles.site_id = sites.id" },
    "site.user": { "via_table": "users_roles", "step_1": "users_roles.site_id = sites.id", "step_2": "users_roles.user_id = users.id" },
    "unit.lock": { "via_table": "v2_locks_to_units", "step_1": "v2_locks_to_units.unit_id = v2_units.id", "step_2": "v2_locks_to_units.lock_id = v2_locks.id" },
    "lock.unit": { "via_table": "v2_locks_to_units", "step_1": "v2_locks_to_units.lock_id = v2_locks.id", "step_2": "v2_locks_to_units.unit_id = v2_units.id" },
    "user.role": {
      "via_table": "users_roles",
      "step_1": "users_roles.user_id = users.id",
      "step_2": "users_roles.role_id = roles.id"
    },
    "role.user": {
      "via_table": "users_roles",
      "step_1": "users_roles.role_id = roles.id",
      "step_2": "users_roles.user_id = users.id"
    }
  },
  "safety": {
    "max_join_depth": 3,
    "max_limit_ceiling": 50,
    "allowed_operators": ["=", "IN", "LIKE"],
    "deny_columns": ["password", "pin", "session_salt", "pin_expiration", "password_url"]
  }
}
