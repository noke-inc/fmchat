  "junction_bridges": {
    "unit.user": {
      "via_table": "users_roles",
      "step_1": "users_roles.site_id = v2_units.site_id",
      "step_2": "users_roles.user_id = users.id"
    },
    "user.unit": {
      "via_table": "users_roles",
      "step_1": "users_roles.user_id = users.id",
      "step_2": "users_roles.site_id = v2_units.site_id"
    },
    "user.site": {
      "via_table": "users_roles",
      "step_1": "users_roles.user_id = users.id",
      "step_2": "users_roles.site_id = sites.id"
    },
    "site.user": {
      "via_table": "users_roles",
      "step_1": "users_roles.site_id = sites.id",
      "step_2": "users_roles.user_id = users.id"
    },
    "unit.lock": {
      "via_table": "v2_locks_to_units",
      "step_1": "v2_locks_to_units.unit_id = v2_units.id",
      "step_2": "v2_locks_to_units.lock_id = v2_locks.id"
    },
    "lock.unit": {
      "via_table": "v2_locks_to_units",
      "step_1": "v2_locks_to_units.lock_id = v2_locks.id",
      "step_2": "v2_locks_to_units.unit_id = v2_units.id"
