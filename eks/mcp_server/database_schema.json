      "step_1": "users_roles.role_id = roles.id",
      "step_2": "users_roles.user_id = users.id"
    },
    "unit.site_hours": {
      "via_table": "v2_units",
      "step_1": "v2_units.id = v2_units.id",
      "step_2": "site_hours.site_id = v2_units.site_id"
    },
    "user.site_hours": {
      "via_table": "users_roles",
      "step_1": "users_roles.user_id = users.id",
      "step_2": "site_hours.site_id = users_roles.site_id"
